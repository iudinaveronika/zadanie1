using System;

namespace з2
{
    class Program
    {
        static void Main()
        {
            string play;

            // Внешний цикл для возможности начать игру заново
            do
            {
                Random rand = new Random();
                int secretNumber = rand.Next(1, 101); 
                int guess;
                int attempts = 0; // Счетчик попыток
                do
                {
                    Console.Write("Угадайте число (1-100): ");
                    guess = int.Parse(Console.ReadLine());
                    attempts++; // Увеличиваем количество попыток

                    if (guess < secretNumber)
                    {
                        Console.WriteLine("Загаданное число больше");
                    }
                    else if (guess > secretNumber)
                    {
                        Console.WriteLine("Загаданное число меньше");
                    }
                } while (guess != secretNumber);

                Console.WriteLine($" Вы угадали число за {attempts} попыток");
                Console.Write("Хотите сыграть еще раз? (да/нет): ");
                play = Console.ReadLine();

            } 
            while (play == "да");

            Console.WriteLine("Спасибо за игру!");
        }
    }
}